# Optional local development configuration. Copy to .env.local if needed.
VITE_BASE_PATH=/

# GitHub Pages builds use this value in .github/workflows/deploy.yml:
# VITE_BASE_PATH=/service-project-manager/

# VITE_* values are public and embedded in the browser bundle. Never add secrets.

# Optional overrides; defaults to the generated public key in src/config/push-public-key.ts.
# VITE_WEB_PUSH_PUBLIC_KEY=
# Optional subscription receiver; without it subscriptions stay local and can be exported.
# VITE_WEB_PUSH_SUBSCRIPTION_ENDPOINT=https://your-server.example/push/subscriptions
# VAPID_PRIVATE_KEY belongs only in server environment, NEVER in VITE_*.
